<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Off"
      throwConfigExceptions="true">

  <extensions>
    <add assembly="NLog.Web.AspNetCore"/>
  </extensions>

  <targets>
    <target xsi:type="File" name="allfile" fileName="logs/library-all-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|CorrelationId=${mdlc:item=CorrelationId}|${message} ${exception:format=tostring}" />

    <target xsi:type="File" name="ownfile" fileName="logs/library-own-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|CorrelationId=${mdlc:item=CorrelationId}|${message} ${exception:format=tostring}" />

    <target xsi:type="Console" name="console"
            layout="${longdate}|${level:uppercase=true}|${logger}|CorrelationId=${mdlc:item=CorrelationId}|${message} ${exception:format=tostring}" />
  </targets>

  <rules>
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="*" minlevel="Debug" writeTo="allfile,console" />
    <logger name="Library.*" minlevel="Debug" writeTo="ownfile" />
  </rules>
</nlog>
